# OTLP in (traces, metrics), traces to Tempo, metrics exposed for Prometheus. No other exporter.
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317   # container side; published on the Tailscale address only
      http:
        endpoint: 0.0.0.0:4318

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 400
  # Defense in depth with the application side: only allowlisted attribute keys survive (resource,
  # span, span event, data point); free-text status messages are blanked. Exemplars are not
  # exposed: the Prometheus exporter below does not enable OpenMetrics and Prometheus runs without
  # exemplar storage, so no trace/span id leaks into metrics.
  transform/allowlist:
    error_mode: ignore
    trace_statements:
      - context: resource
        statements:
          - keep_matching_keys(attributes, "^({{ monitoring_otel_resource_keys | join('|') }})$")
      - context: span
        statements:
          - keep_matching_keys(attributes, "^({{ monitoring_otel_signal_keys | join('|') }})$")
          - set(status.message, "")
      - context: spanevent
        statements:
          - keep_matching_keys(attributes, "^({{ monitoring_otel_signal_keys | join('|') }})$")
    metric_statements:
      - context: resource
        statements:
          - keep_matching_keys(attributes, "^({{ monitoring_otel_resource_keys | join('|') }})$")
      - context: datapoint
        statements:
          - keep_matching_keys(attributes, "^({{ monitoring_otel_signal_keys | join('|') }})$")
  batch: {}

exporters:
  otlp/tempo:
    endpoint: tempo:4317
    tls:
      insecure: true   # container-to-container on an internal network
  prometheus:
    endpoint: 0.0.0.0:8889
    enable_open_metrics: false   # no exemplars
    resource_to_telemetry_conversion:
      enabled: true

service:
  telemetry:
    metrics:
      level: none
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, transform/allowlist, batch]
      exporters: [otlp/tempo]
    metrics:
      receivers: [otlp]
      processors: [memory_limiter, transform/allowlist, batch]
      exporters: [prometheus]
