{
  "uid": "sada-overview",
  "title": "Sadā overview (placeholder)",
  "tags": [
    "sada"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "Placeholder: metric names are the ones the app is expected to export over OTLP (not instrumented yet). Adjust once the instrumentation lands.",
  "templating": {
    "list": [
      {
        "name": "mosque",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(sada_orchestrator_state,mosque)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Orchestrator state per mosque",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sada_orchestrator_state{mosque=~\"$mosque\"}",
          "legendFormat": "{{mosque}} {{state}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Live on",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sada_live_on{mosque=~\"$mosque\"}",
          "legendFormat": "{{mosque}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Jobs by status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (sada_jobs{mosque=~\"$mosque\"})",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM errors (rate 5m)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mosque) (rate(sada_llm_errors_total{mosque=~\"$mosque\"}[5m]))",
          "legendFormat": "{{mosque}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Transcription errors (rate 5m)",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mosque) (rate(sada_transcription_errors_total{mosque=~\"$mosque\"}[5m]))",
          "legendFormat": "{{mosque}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pod CPU (cores)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"sada\",container!=\"\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Pod memory (working set)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"sada\",container!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ]
}