      "type": "timeseries",
      "title": "Ingest connected",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (mosque) (sada_ingest_connected_ratio{mosque=~\"$mosque\"})",
          "legendFormat": "{{mosque}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Orchestrator state transitions (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mosque, from_state, to_state) (increase(sada_state_transitions_total{mosque=~\"$mosque\"}[5m]))",
          "legendFormat": "{{mosque}} {{from_state}}>{{to_state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Empty until a transition happens"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Job runs by kind and status (rate 5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mosque, kind, status) (rate(sada_job_runs_total{mosque=~\"$mosque\"}[5m]))",
          "legendFormat": "{{mosque}} {{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "description": "Back-office jobs, by mosque (runs with no known mosque have no label). Empty until a job runs"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Job duration p95 by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, mosque, kind) (rate(sada_job_duration_seconds_bucket{mosque=~\"$mosque\"}[5m])))",
          "legendFormat": "{{mosque}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
